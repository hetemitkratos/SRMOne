# ─── Academia Backend Environment Variables ───────────────────────────────────
# Copy to .env for local dev. For production, set these in Render dashboard.

# Server port (Render sets this automatically, only needed locally)
PORT=3000

# CORS — comma-separated list of allowed origins
# Production: https://srmone.in,https://www.srmone.in
# Local: http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174

# Supabase (for profile caching, attendance history, settings sync, notifications)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Encryption key for storing academia/SP passwords (must be 32+ chars)
ENCRYPTION_KEY=your-32-plus-char-encryption-key-here

# Optional: Override the Go scraper binary path
# ACADEMIA_SCRAPER_BIN=/app/academia-scraper/loginprobe

# Captcha solving API (required for Student Portal login)
CAPTCHA_SOLVE_API_KEY=your-captcha-api-key
CAPTCHA_SOLVE_API_URL=https://your-captcha-solve-api-url.com/solve
