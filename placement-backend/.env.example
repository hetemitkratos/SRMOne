# ─── Placement Backend Environment Variables ──────────────────────────────────
# Copy to .env for local dev. For production, set these in Render dashboard.

# Server port
PORT=3001

# CORS — comma-separated list of allowed origins
# Production: https://srmone.in,https://www.srmone.in
# Local: http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174

# Supabase (for encrypted credential storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Encryption key for placement portal passwords (32-char hex)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your-32-char-hex-key-here
