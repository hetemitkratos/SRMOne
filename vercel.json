{
  "buildCommand": "npm run build",
  "outputDirectory": "academia-backend/frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://academia-backend-5h12.onrender.com/api/:path*" },
    { "source": "/placement-api/:path*", "destination": "https://placement-backend-xpub.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
