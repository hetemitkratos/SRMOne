{
  "buildCommand": "npm run build",
  "outputDirectory": "academia-backend/frontend/dist",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://academia-backend-5h12.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/health", "schedule": "0 5 * * *" }
  ]
}
