<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: the saved sign-in is
     encrypted with a key that never leaves this device, so a restored copy
     can't be read. A new phone signs in again and re-syncs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
